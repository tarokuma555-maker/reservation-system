// デモ用スキーマ。
// 本番は PostgreSQL を想定しているが、デモは追加のインフラなしで動かせるよう SQLite を使う。
// 金額はすべて「円単位の整数（税込）」で保持する。円未満の単位が存在しないため、
// 浮動小数点数を一切使わずに消費税計算ができる（要件定義 付録C）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Setting {
  key       String   @id
  value     String // JSON文字列
  updatedAt DateTime @updatedAt
}

model Staff {
  id             String        @id @default(cuid())
  name           String
  role           String        @default("owner") // owner | staff
  canHandleOnline Boolean      @default(true)
  baseAddress    String        @default("")
  isActive       Boolean       @default(true)
  reservations   Reservation[]
  businessHours  BusinessHour[]
  blockedSlots   BlockedSlot[]
}

model Customer {
  id             String        @id @default(cuid())
  lineUserId     String        @unique
  name           String
  nameKana       String        @default("")
  phone          String        @default("")
  email          String?
  postalCode     String?
  address        String?
  buildingName   String?
  layout         String? // 1LDK / 2LDK / 3LDK以上
  hasPet         Boolean       @default(false)
  keyHandover    String? // 在宅 / キーボックス / 預かり
  companyName    String? // 法人顧客の場合
  registrationNumber String? // 相手方のインボイス登録番号
  invoiceDelivery String       @default("line") // line | email | print
  note           String        @default("")
  tags           String        @default("") // カンマ区切り
  consentAt      DateTime?
  createdAt      DateTime      @default(now())
  reservations   Reservation[]
  recurringRules RecurringRule[]
  invoices       Invoice[]
  messages       OutboundMessage[]
}

model Menu {
  id                String   @id @default(cuid())
  category          String
  name              String
  deliveryType      String // visit | online
  description       String   @default("")
  durationMinutes   Int
  price             Int // 税込価格（総額表示義務に合わせて税込で保持）
  taxRate           Int      @default(10)
  applyLayoutAdjust Boolean  @default(false)
  isRecurringOnly   Boolean  @default(false)
  isFirstTimeOnly   Boolean  @default(false)
  sortOrder         Int      @default(0)
  isPublished       Boolean  @default(true)
  options           MenuOption[]
  reservations      Reservation[]
  recurringRules    RecurringRule[]
}

model MenuOption {
  id                String  @id @default(cuid())
  menuId            String?
  menu              Menu?   @relation(fields: [menuId], references: [id])
  name              String
  additionalMinutes Int     @default(0)
  additionalPrice   Int     @default(0)
  sortOrder         Int     @default(0)
  isPublished       Boolean @default(true)
  reservationOptions ReservationOption[]
}

model Reservation {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  staffId         String
  staff           Staff    @relation(fields: [staffId], references: [id])
  menuId          String
  menu            Menu     @relation(fields: [menuId], references: [id])
  recurringRuleId String?
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id])
  occurrenceDate  String? // 定期の本来の実施日 YYYY-MM-DD
  startAt         DateTime
  endAt           DateTime
  totalMinutes    Int
  totalPrice      Int // 税込
  status          String   @default("confirmed")
  // confirmed | completed | cancelled_by_customer | cancelled_by_owner | skipped | no_show
  deliveryType    String // visit | online
  serviceAddress  String? // 訪問時の実施場所スナップショット
  meetingUrl      String? // オンライン時の会議URL
  source          String   @default("line") // line | admin | phone
  isException     Boolean  @default(false)
  paymentStatus   String   @default("unpaid") // unpaid | cash_received | transfer_confirmed
  customerNote    String   @default("")
  internalNote    String   @default("")
  cancelledAt     DateTime?
  cancelReason    String?
  cancelFee       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  options         ReservationOption[]
  logs            ReservationLog[]
  invoiceLines    InvoiceLine[]

  @@index([startAt])
  @@index([recurringRuleId])
}

model ReservationOption {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  optionId      String
  option        MenuOption  @relation(fields: [optionId], references: [id])
  name          String
  additionalMinutes Int
  additionalPrice   Int
}

model RecurringRule {
  id              String   @id @default(cuid())
  customerId      String
  customer        Customer @relation(fields: [customerId], references: [id])
  staffId         String
  menuId          String
  menu            Menu     @relation(fields: [menuId], references: [id])
  frequency       String // weekly | biweekly | every4weeks | monthly_nth
  dayOfWeek       Int // 0=日 .. 6=土
  nthWeek         Int? // monthly_nth の第N週
  startTime       String // "10:00"
  durationMinutes Int
  startDate       String // YYYY-MM-DD
  endDate         String?
  status          String   @default("active") // active | paused | ended
  pausedFrom      String?
  pausedTo        String?
  generatedUntil  String? // YYYY-MM-DD
  createdAt       DateTime @default(now())
  reservations    Reservation[]
}

model BusinessHour {
  id        String  @id @default(cuid())
  staffId   String?
  staff     Staff?  @relation(fields: [staffId], references: [id])
  dayOfWeek Int
  openTime  String // "09:00"
  closeTime String // "18:00"
  isClosed  Boolean @default(false)
  // 提供形態別の受付時間帯（null なら全形態で受付）
  deliveryType String?
}

model Holiday {
  id      String @id @default(cuid())
  date    String // YYYY-MM-DD
  endDate String?
  reason  String @default("")
}

model BlockedSlot {
  id       String   @id @default(cuid())
  staffId  String
  staff    Staff    @relation(fields: [staffId], references: [id])
  startAt  DateTime
  endAt    DateTime
  title    String   @default("")
  source   String   @default("manual") // manual | google
  googleEventId String?
}

model Invoice {
  id                 String   @id @default(cuid())
  invoiceNumber      String   @unique
  type               String   @default("receipt") // invoice | receipt | returned | corrected
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id])
  issueDate          String // YYYY-MM-DD
  subtotalByTaxRate  String // JSON { "10": 16873 }  税抜
  taxByTaxRate       String // JSON { "10": 1687 }
  totalAmount        Int // 税込合計
  registrationNumber String // 発行時点の自社登録番号スナップショット
  issuerName         String // 発行時点の事業者名スナップショット
  recipientName      String // 発行時点の宛名スナップショット
  relatedInvoiceId   String?
  status             String   @default("issued") // issued | sent | void
  voidReason         String?
  correctionReason   String?
  sentAt             DateTime?
  sentVia            String? // line | email | print
  pdfPath            String?
  createdAt          DateTime @default(now())
  lines              InvoiceLine[]

  @@index([issueDate])
  @@index([totalAmount])
}

model InvoiceLine {
  id            String       @id @default(cuid())
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  transactionDate String // YYYY-MM-DD
  description   String
  quantity      Int          @default(1)
  unitPrice     Int // 税込単価
  amount        Int // 税込金額
  taxRate       Int          @default(10)
  isReducedTaxRate Boolean   @default(false)
}

model ReservationLog {
  id            String      @id @default(cuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  actorType     String // customer | owner | system
  actorName     String      @default("")
  action        String
  detail        String      @default("")
  createdAt     DateTime    @default(now())
}

/* ===================== 外部連携 ===================== */

/// LINEへ送信したメッセージ。モックモードではここにだけ記録される。
model OutboundMessage {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  reservationId String?
  type          String // booking_confirmed / reminder / online_soon / cancelled / completed / invoice / broadcast など
  channel       String   @default("line")
  payload       String // 実際にMessaging APIへ送るJSON
  status        String   @default("queued") // queued | sent | failed | mocked
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
}

/// LINEから受け取ったWebhookイベント。再送に備えてイベントIDで冪等にする。
model WebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  lineUserId String?
  payload    String
  processed  Boolean  @default(false)
  note       String   @default("")
  receivedAt DateTime @default(now())
}

/// リッチメニューの定義。未予約者向け／予約保有者向けを出し分ける。
model RichMenu {
  id            String  @id @default(cuid())
  name          String
  target        String // default | booked
  chatBarText   String  @default("メニュー")
  areas         String // JSON: [{label, icon, action}]
  isPublished   Boolean @default(false)
  lineRichMenuId String?
  updatedAt     DateTime @updatedAt
}

/// Googleカレンダーのイベント。モックモードでは「Google側の状態」をこのテーブルで再現する。
model CalendarEvent {
  id                  String   @id @default(cuid())
  calendarId          String   @default("primary")
  googleEventId       String   @unique
  summary             String
  description         String   @default("")
  location            String   @default("")
  startAt             DateTime
  endAt               DateTime
  conferenceUrl       String?
  privateReservationId String? // extendedProperties.private.reservationId
  source              String   @default("system") // system = 本システムが作成 / personal = 手元で入れた私用予定
  isDeleted           Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  @@index([startAt])
}

/// 予約とGoogleカレンダーイベントの同期状態。失敗はキューに残してリトライする。
model CalendarSync {
  id            String   @id @default(cuid())
  reservationId String   @unique
  googleEventId String?
  calendarId    String   @default("primary")
  syncStatus    String   @default("pending") // pending | synced | failed | deleted
  retryCount    Int      @default(0)
  lastError     String?
  lastSyncedAt  DateTime?
  updatedAt     DateTime @updatedAt
}

/* ===================== 会計 ===================== */

/// 証憑（電子帳簿保存法の保存対象）。太字の3項目が検索要件。
model Document {
  id                String   @id @default(cuid())
  kind              String // issued_invoice | received_receipt | received_invoice
  filePath          String
  mimeType          String   @default("application/pdf")
  fileHash          String   @default("")
  transactionDate   String // 検索要件①
  transactionAmount Int // 検索要件②
  counterpartyName  String // 検索要件③
  retentionUntil    String // この日まで削除禁止
  uploadedAt        DateTime @default(now())
  deletedAt         DateTime?
  expenses          Expense[]
  logs              DocumentLog[]

  @@index([transactionDate])
  @@index([transactionAmount])
  @@index([counterpartyName])
}

model DocumentLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  action     String // create | update | logical_delete | restore
  detail     String   @default("")
  actorName  String   @default("オーナー")
  createdAt  DateTime @default(now())
}

model Account {
  code      String  @id
  name      String
  type      String // asset | liability | equity | revenue | expense
  taxCategory String @default("対象外") // 課税10 | 軽減8 | 非課税 | 不課税 | 対象外
  sortOrder Int     @default(0)
  lines     JournalLine[]
  expenses  Expense[]
  assets    FixedAsset[]
}

model FiscalYear {
  id        String   @id @default(cuid())
  name      String
  startDate String
  endDate   String
  status    String   @default("open") // open | closed
  entries   JournalEntry[]
}

model JournalEntry {
  id           String   @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  entryDate    String // YYYY-MM-DD
  description  String
  sourceType   String // invoice | payment | expense | depreciation | adjustment | manual
  sourceId     String?
  isAdjusting  Boolean  @default(false)
  isLocked     Boolean  @default(false)
  createdAt    DateTime @default(now())
  lines        JournalLine[]
  expenses     Expense[]

  @@index([entryDate])
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountCode    String
  account        Account @relation(fields: [accountCode], references: [code])
  side           String // debit | credit
  amount         Int
  taxCategory    String  @default("対象外")
  taxAmount      Int     @default(0)
  hasQualifiedInvoice Boolean @default(true)
  note           String  @default("")
}

model Expense {
  id            String   @id @default(cuid())
  expenseDate   String
  accountCode   String
  account       Account  @relation(fields: [accountCode], references: [code])
  amount        Int // 税込
  taxCategory   String   @default("課税10")
  vendorName    String
  vendorRegistrationNumber String?
  invoiceStatus String   @default("qualified") // qualified | non_qualified | small_amount_exception
  documentId    String?
  document      Document? @relation(fields: [documentId], references: [id])
  journalEntryId String?
  journalEntry  JournalEntry? @relation(fields: [journalEntryId], references: [id])
  ocrRawText    String   @default("")
  note          String   @default("")
  createdAt     DateTime @default(now())

  @@index([expenseDate])
}

model FixedAsset {
  id                     String @id @default(cuid())
  name                   String
  acquisitionDate        String
  acquisitionCost        Int
  accountCode            String
  account                Account @relation(fields: [accountCode], references: [code])
  usefulLife             Int // 耐用年数
  method                 String @default("straight_line") // 定額法
  accumulatedDepreciation Int   @default(0)
  disposedAt             String?
}
