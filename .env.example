# ===== 本番で必要な設定 =====
# 開発中は .env に、本番は Vercel の環境変数に入れます。
# LINEとGoogleカレンダーの「合いことば」はここには書きません。管理画面から入れます。

# --- データベース（PostgreSQL） ---
# Neon / Supabase / Vercel Postgres などで作った接続文字列を入れます。
# DATABASE_URL は接続プール経由、DIRECT_URL はスキーマ変更用の直結です。
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- 合いことばを暗号化する鍵 ---
# 必須。これが無いと、管理画面からLINEやGoogleにつなげません。
# 作り方:  openssl rand -base64 32
ENCRYPTION_KEY=""

# --- 管理画面のログイン（Googleアカウント） ---
# 作り方:  openssl rand -base64 32
AUTH_SECRET=""
# Google Cloud の「OAuth クライアント ID」から。
# 承認済みリダイレクトURI に <APP_BASE_URL>/api/auth/callback/google を登録します。
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# 最初に管理画面へ入れるメールアドレス（カンマ区切り）。
# 一度ログインすると、その人がスタッフとして登録されます。
ADMIN_EMAILS=""

# --- アプリのURL ---
# LINEに載せるリンクと、Googleの戻り先に使います。本番のURLを入れてください。
APP_BASE_URL="http://127.0.0.1:3000"

# --- 定時実行の受け口を守る合いことば ---
# 作り方:  openssl rand -base64 32
CRON_SECRET=""

# --- 領収書PDFの保管先（Vercel Blob） ---
BLOB_READ_WRITE_TOKEN=""

# ===== 以下は任意 =====

# レシートの読み取り（Google Cloud Vision）。未設定ならサンプル文面を使います。
GOOGLE_VISION_API_KEY=""

# PDF生成に使うChromiumの場所。通常は自動で見つかります。
# CHROMIUM_PATH="/usr/bin/chromium"

# ===== 管理画面から入れるもの（ここには書きません） =====
# ・LINEのチャネルアクセストークン / チャネルシークレット / LIFF ID
#   → 管理画面の「LINEの設定」から。別のアカウントへの乗り換えも画面でできます。
# ・GoogleカレンダーのクライアントID / シークレット / 継続利用の許可
#   → 管理画面の「カレンダー連携」から。
