# ===== 実接続に切り替えるための環境変数 =====
# いずれも未設定ならモックモードで動作します（デモはこのままで動きます）。

# アプリのURL（PDF生成とLINEに載せるリンクで使う）
APP_BASE_URL="http://127.0.0.1:3000"
LIFF_BASE_URL="http://127.0.0.1:3000/liff"

# --- LINE Messaging API ---
# LINE Developers でMessaging APIチャネルを作り、以下を設定する。
# Webhook URL には  <APP_BASE_URL>/api/line/webhook  を登録する。
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# --- Google Calendar ---
# Google Cloud で Calendar API を有効化し、OAuthクライアントを作成。
# オーナーのアカウントで一度認可してリフレッシュトークンを取得する。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"

# --- レシートOCR（Google Cloud Vision） ---
GOOGLE_VISION_API_KEY=""

# --- PDF生成 ---
# 通常は自動で見つかる。見つからない場合のみChromiumのパスを指定する。
# CHROMIUM_PATH="/usr/bin/chromium"
